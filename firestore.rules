// ===========================================================================
//  📦 재고관리 — Firestore 보안 규칙
// ===========================================================================
//  ⚠️ 결론부터: **콘솔에서 아무것도 안 바꿔도 됩니다.**
//
//  기존 프로젝트 `jangggimaster` 에 이미 아래 규칙이 게시되어 있고,
//  `/{document=**}` 는 모든 컬렉션을 뜻하므로 이 앱이 쓰는 세 컬렉션
//  (inventory_items · inventory_photos · inventory_sales) 도 이미 허용됩니다.
//  이 파일은 '지금 무엇이 걸려 있는지' 를 기록해 두려고 남깁니다.
// ===========================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


// ===========================================================================
//  ▼ 나중에 잠그고 싶어질 때만 (지금은 필요 없음)
// ===========================================================================
//  `if true` 는 프로젝트 ID 를 아는 사람이면 누구나 **읽고 고치고 지울 수** 있다는 뜻입니다.
//  프로젝트 ID 와 apiKey 는 브라우저에 그대로 보이므로 숨겨지지 않습니다.
//  구글도 이 상태면 주기적으로 '보안 규칙이 공개 상태' 라는 메일을 보냅니다.
//
//  잠그려면 두 가지를 같이 해야 합니다 — 하나만 하면 앱이 저장을 못 합니다.
//    ① config.js 의 `USE_ANON_AUTH` 를 true 로 바꾼다
//    ② 콘솔 → Authentication → 시작하기 → '익명' 을 켠다
//  그리고 아래 내용을 규칙 탭에 붙여넣습니다.
//
//  ⚠️ 이 규칙은 재고관리 세 컬렉션만 다룹니다. `jangggimaster` 를 쓰는 **다른 앱이
//     있다면 그 컬렉션 규칙도 여기에 같이 적어야 합니다** — 안 적으면 맨 아래
//     `if false` 에 걸려 그 앱이 조용히 멈춥니다.
//
//  rules_version = '2';
//  service cloud.firestore {
//    match /databases/{database}/documents {
//
//      function signedIn() { return request.auth != null; }
//
//      match /inventory_items/{itemId}  { allow read, write, delete: if signedIn(); }
//      match /inventory_photos/{itemId} { allow read, write, delete: if signedIn(); }
//      match /inventory_sales/{saleId}  { allow read, write, delete: if signedIn(); }
//
//      // 👇 jangggimaster 를 쓰는 다른 앱의 컬렉션을 여기에 추가하세요
//      // match /기존컬렉션이름/{docId} { allow read, write: if true; }
//
//      match /{document=**} { allow read, write: if false; }
//    }
//  }
//
//  ※ 익명 로그인은 자물쇠가 아니라 문고리입니다. 주소와 설정값을 아는 사람은
//    스스로 익명 로그인을 만들어 들여다볼 수 있습니다. 정말 잠가야 하는 자료는
//    이 앱에 넣지 마세요.
// ===========================================================================
